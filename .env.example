# Copy to .env and fill in real values.
# .env is auto-loaded from CWD at script startup.

# GitHub Personal Access Token (classic with public_repo, or fine-grained).
GITHUB_TOKEN=

# Snyk Personal/Service Account token. Header format is "Authorization: token <value>".
SNYK_TOKEN=

# Snyk organization UUID. Find it at https://app.snyk.io/org/<slug>/manage/settings .
SNYK_ORG_ID=

# Optional: override the Snyk API base URL (use for custom/private Snyk deployments).
# Defaults to https://api.snyk.io if unset.
SNYK_API_BASE=

# Optional: Snyk REST API date version. Defaults to 2024-10-15 if unset.
SNYK_API_VERSION=

# Optional: contact email for the ecosyste.ms polite rate-limit tier.
# Defaults to "operational-metrics-script@local" if unset.
CONTACT_EMAIL=
